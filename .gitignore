# ============================================================================
#  VIZO ERP — .gitignore
# ============================================================================

# ────────────── Node / Next.js (vizo-erp) ──────────────
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.turbo/

# ────────────── npm / yarn / pnpm logs ──────────────
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# ────────────── Env / secrets ──────────────
**/.env
**/.env.local
**/.env.*.local
**/.env.development.local
**/.env.production.local

# ────────────── IDE / OS ──────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ────────────── Coverage / cache ──────────────
**/coverage/
**/.nyc_output/
**/.cache/
**/.eslintcache

# ────────────── TypeScript build info ──────────────
**/*.tsbuildinfo
**/next-env.d.ts

# ────────────── Vercel ──────────────
**/.vercel/

# ────────────── Logs ──────────────
**/logs/
**/*.log

# ────────────── Local secret seeds ──────────────
**/secrets.json
**/credentials.json
